# --- Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/load_shedding_db?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google Social Login (GCP OAuth) ---
GOOGLE_CLIENT_ID=your-gcp-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-gcp-oauth-client-secret

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=30

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12
